    "hts_block": "9903.05.20-9903.06.21",
    "trigger": "country_of_origin",
    "value_basis": "entered_value_ch1_97",
    "economies": 60,
    "notes": "Additional 10% or 12.5% ad valorem by country of origin. Suppression is evaluated before rate math."
  },
  "rate_logic": {
    "FLAT": "duty = entered_value * rate_pct / 100 (additive on column-1)",
    "COMBINED_TO_CAP": "if col1_pct >= cap_pct -> no additional duty (report no_additional_duty_heading); else 301 = entered_value * (cap_pct - col1_pct)/100 (report combined_to_cap_heading). Total line = cap.",
    "SUPPRESSION": "duty = 0. Report the exemption heading, EXCEPT do not stack a 0% exemption heading on a line already carrying another trade-remedy duty (e.g. a Section 232 duty line) -> ACE F775."
  },
