PORT=8080
APP_SURFACE=local
ALLOW_GUEST=true

# API keys (local / service)
#   dev-internal  — admin, unlimited
#   dev-calculate — signed-in style quotas, no rule write
#   dev-external  — guest quotas (WordPress-like)
API_KEY_INTERNAL=dev-internal
API_KEY_CALCULATE=dev-calculate

# Auth0 (playground + external — same tenant ok; separate apps/clients)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ADMIN_CLAIM=https://klearnow.com/roles

# Daily quotas
QUOTA_ANON_STACKS=5
QUOTA_ANON_EXTRACTS=2
QUOTA_USER_STACKS=50
QUOTA_USER_EXTRACTS=10

# WordPress / marketing parents allowed to iframe
FRAME_ANCESTORS='self' https://*.klearnow.com https://klearnow.com

# Rule chat (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
