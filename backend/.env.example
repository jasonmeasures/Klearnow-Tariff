PORT=8080
APP_SURFACE=local
ALLOW_GUEST=true

# API keys (local / service)
#   dev-internal  — admin, unlimited
#   dev-calculate — signed-in style quotas, no rule write
#   dev-external  — guest quotas (WordPress-like)
API_KEY_INTERNAL=dev-internal
API_KEY_CALCULATE=dev-calculate

# Auth0 (playground + external — same tenant ok; separate apps/clients)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ADMIN_CLAIM=https://klearnow.com/roles
# Access tokens should include an `email` claim (Auth0 Action) when using the users DB.

# Optional PostgreSQL — when set, Auth0 is authenticator only; roles come from `users`.
# Leave unset for local/dev claim-based fallback (or API keys).
# DATABASE_URL=postgres://user:pass@localhost:5432/klearnow_tariff
# Or discrete:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=klearnow_tariff
# Comma-separated emails upserted as active admins on boot (and on next login).
ADMIN_BOOTSTRAP_EMAILS=
# How unknown Auth0 emails are handled when the users DB is enabled:
#   true  — create active role=user (internal users can work immediately)
#   false — reject until an admin provisions them in Manage → Users
#   unset — true for SURFACE=playground|external, false otherwise
USER_AUTO_PROVISION=

# Daily quotas (in-memory per process — not shared across EB instances)
QUOTA_ANON_STACKS=5
QUOTA_ANON_EXTRACTS=2
QUOTA_USER_STACKS=50
QUOTA_USER_EXTRACTS=10
# For 50–100 daily active Duty-stack users on playground, raise e.g.:
# QUOTA_USER_STACKS=200
# QUOTA_USER_EXTRACTS=25

# Concurrency / payload guards (single Node process)
# JSON_LIMIT=1mb
# JSON_UPLOAD_LIMIT=32mb
# JSON_HTS_IMPORT_LIMIT=96mb
# MAX_ASSESS_LINES=500
# MAX_COVERAGE_ROWS=5000
# MAX_ES003_LINES=8000
# MAX_ES003_TARIFF_ROWS=20000
# MAX_XLSX_BYTES=20971520
# MAX_HEAVY_JOBS=2
# REQUEST_TIMEOUT_MS=180000

# WordPress / marketing parents allowed to iframe
FRAME_ANCESTORS='self' https://*.klearnow.com https://klearnow.com

# Rule chat (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
