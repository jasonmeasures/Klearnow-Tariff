# Used when the SPA calls the API directly (production Amplify).
# Locally, Vite proxies /v1 → http://localhost:8080.
VITE_API_URL=

# local | playground | external | engine
VITE_SURFACE=local

# Optional override; local defaults to dev-internal. Leave empty for external guest mode.
VITE_API_KEY=

# Auth0 (external + playground / engine)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Restricted Party Screening — opens from the top bar (applications/RPS).
# Local default: http://localhost:3002  |  Playground: set Amplify / custom domain URL
VITE_RPS_URL=http://localhost:3002
